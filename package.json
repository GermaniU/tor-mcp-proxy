{
  "name": "tor-mcp-proxy",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server that gives AI assistants web access through Tor: per-call circuit isolation, .onion support, no DNS leaks, automatic retries on blocked exit nodes.",
  "type": "module",
  "author": "GermaniU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GermaniU/tor-mcp-proxy.git"
  },
  "homepage": "https://github.com/GermaniU/tor-mcp-proxy#readme",
  "bugs": {
    "url": "https://github.com/GermaniU/tor-mcp-proxy/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tor",
    "onion",
    "socks5",
    "proxy",
    "privacy",
    "claude"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "bin": {
    "tor-mcp-proxy": "index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "check": "node scripts/check-syntax.js",
    "test": "node --test \"test/**/*.test.js\"",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "list-tools": "node scripts/list-tools.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tough-cookie": "^6.0.2",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
